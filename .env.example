# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=myuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smartreco_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# MLflow
# ==========================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=smartreco-als2

# ==========================================
# Airflow
# ==========================================
AIRFLOW_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY

# ==========================================
# Event Generation
# ==========================================
FRESH_EVENTS_BATCH_SIZE=1000

# Optional: leave empty to generate a unique batch key
FRESH_EVENTS_BATCH_KEY=

# ==========================================
# Data Validation
# ==========================================
VALIDATION_LOOKBACK_HOURS=24

# ==========================================
# Analytics Database
# ==========================================
ANALYTICS_DATABASE_URL=postgresql://myuser:CHANGE_ME@localhost:5432/smartreco_db